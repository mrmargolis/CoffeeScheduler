<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Coffee Scheduler</string>
	<!-- Accept ZIP files so the app shows up in the share sheet for a
	     BeanConqueror export. Shared files arrive via onOpenURL. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>BeanConqueror Export</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.zip-archive</string>
				<string>com.pkware.zip-archive</string>
			</array>
		</dict>
	</array>
	<!-- The Scan button on the Beans screen photographs a bag's label. -->
	<key>NSCameraUsageDescription</key>
	<string>Photograph a coffee bag's label to look the coffee up on Bean Base. The photo is read on this iPhone and isn't kept.</string>
	<!-- Shared files are copied into the app's Inbox rather than opened in place. -->
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<false/>
</dict>
</plist>
